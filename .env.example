# MainStreet AI — Parts 2 & 3 backend configuration.
# Copy to .env.local and fill in what you have. Every key is OPTIONAL:
# with nothing set, the app runs in mock mode (fictional sample businesses,
# rules-only analysis, no LLM). Never commit .env.local.

# Google Places API (New). Enables real business search, details and up to 5 reviews.
# Needs "Places API (New)" enabled in Google Cloud. Restrict the key to that API.
GOOGLE_PLACES_API_KEY=

# OpenRouter. Enables optional LLM help: review theme classification, website
# extraction, and plain-English rewording. Never used for money figures.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Catalog scripts only (npm run catalog:build): a stronger model for reading vendor pages,
# and a hard cap on AI calls per run. Falls back to OPENROUTER_MODEL.
# Chosen Nov 7 after a 3-model trial (see docs/specs/b-real-catalog.md §4): anthropic/claude-haiku-5.5
OPENROUTER_STRONG_MODEL=
CATALOG_MAX_CALLS=600

# Set to 1 to force the LLM off even when a key is present.
LLM_DISABLED=
# Hard cap on LLM calls per hour (per server process).
LLM_MAX_CALLS_PER_HOUR=200

# Outbound HTTP timeout for website scans and Places calls, in milliseconds.
HTTP_TIMEOUT_MS=8000
# Max pages read per website scan (home page included).
WEBSITE_MAX_PAGES=6

# debug | info | warn | error. Logs are JSON lines; secret-looking fields are redacted.
LOG_LEVEL=info

# Optional. Checks Google's unsafe-site list. Without it, that part of the Safety Check is skipped.
# GOOGLE_SAFE_BROWSING_API_KEY=

# Optional. Signs the journey "context" token (/api/journey/*) so it can't be edited by hand.
# Any long random string, e.g. `openssl rand -base64 32`. Without it the token is unsigned but still validated.
JOURNEY_SECRET=

# --- Tool discovery and the review queue (docs/DISCOVERY.md) ---
# Code reviewers type on /admin. Without it, /admin is locked in production (open in local dev).
ADMIN_TOKEN=
# Vercel sends this to the weekly discovery job (vercel.json → crons). Any long random string.
CRON_SECRET=
# Where the queue and decisions are saved. Vercel fills these when you connect
# "Upstash for Redis" (Storage / Marketplace). Without them: memory (lost on restart).
KV_REST_API_URL=
KV_REST_API_TOKEN=
